{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xiaomi Debloat Tool",
  "version": "0.1.0",
  "identifier": "com.xiaomidebloat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Xiaomi Debloat Tool",
      "width": 1280,
      "height": 840,
      "minWidth": 850,
      "minHeight": 620
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
